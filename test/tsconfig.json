{
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "@/*"                : [ "src/*"                     ],
      "@/test/*"           : [ "test/src/*"                ],
      "@/pkg"              : [ "src/index.js"              ],
      "@/pkg/address"      : [ "src/lib/address/index.js"  ],
      "@/pkg/meta"         : [ "src/lib/meta/index.js"     ],
      "@/pkg/psbt"         : [ "src/lib/psbt/index.js"     ],
      "@/pkg/script"       : [ "src/lib/script/index.js"   ],
      "@/pkg/sighash"      : [ "src/lib/sighash/index.js"  ],
      "@/pkg/signer"       : [ "src/lib/signer/index.js"   ],
      "@/pkg/taproot"      : [ "src/lib/taproot/index.js"  ],
      "@/pkg/tx"           : [ "src/lib/tx/index.js"       ],
      "@/pkg/witness"      : [ "src/lib/witness/index.js"  ],
      "@/pkg/util"         : [ "src/util/index.js"         ]
    },
    "module": "NodeNext",
    "target": "ESNext",
    "moduleResolution": "NodeNext",
    "importHelpers": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "strict": true,
    "pretty": true,
    "removeComments": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "exclude": [ "node_modules" ],
  "include": [ "**/*.ts" ]
}
