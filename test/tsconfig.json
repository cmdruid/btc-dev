{
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "@/test/*"           : [ "test/src/*"                ],
      "@/src"              : [ "src/index.js"              ],
      "@/src/address"      : [ "src/lib/address/index.js"  ],
      "@/src/meta"         : [ "src/lib/meta/index.js"     ],
      "@/src/psbt"         : [ "src/lib/psbt/index.js"     ],
      "@/src/script"       : [ "src/lib/script/index.js"   ],
      "@/src/sighash"      : [ "src/lib/sighash/index.js"  ],
      "@/src/taproot"      : [ "src/lib/taproot/index.js"  ],
      "@/src/tx"           : [ "src/lib/tx/index.js"       ],
      "@/src/util"         : [ "src/util/index.js"         ]
    },
    "module": "NodeNext",
    "target": "ESNext",
    "moduleResolution": "NodeNext",
    "importHelpers": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "strict": true,
    "pretty": true,
    "removeComments": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "exclude": [ "node_modules" ],
  "include": [ "**/*.ts" ]
}
