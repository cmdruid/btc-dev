{
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "@/test/*"           : [ "test/src/*"            ],
      "@/dist"             : [ "src/index.js"          ],
      "@/dist/address"     : [ "src/address/index.js"  ],
      "@/dist/meta"        : [ "src/meta/index.js"     ],
      "@/dist/psbt"        : [ "src/psbt/index.js"     ],
      "@/dist/script"      : [ "src/script/index.js"   ],
      "@/dist/sighash"     : [ "src/sighash/index.js"  ],
      "@/dist/taproot"     : [ "src/taproot/index.js"  ],
      "@/dist/tx"          : [ "src/tx/index.js"       ],
      "@/dist/util"        : [ "src/util/index.js"     ]
    },
    "module": "NodeNext",
    "target": "ESNext",
    "moduleResolution": "NodeNext",
    "importHelpers": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "strict": true,
    "pretty": true,
    "removeComments": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "exclude": [ "node_modules" ],
  "include": [ "**/*.ts" ]
}
